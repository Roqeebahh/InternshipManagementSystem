@model IEnumerable<Evaluation>
@{
    ViewData["Title"] = "Evaluations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-star me-2"></i>All Evaluations</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Create Evaluation
    </a>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Intern</th>
                        <th>Punctuality</th>
                        <th>Teamwork</th>
                        <th>Skill Level</th>
                        <th>Average</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var eval in Model)
                    {
                        <tr>
                            <td>@eval.EvaluationDate.ToString("MMM dd, yyyy")</td>
                            <td>@eval.Intern?.FullName</td>
                            <td>@eval.Punctuality/10</td>
                            <td>@eval.Teamwork/10</td>
                            <td>@eval.SkillLevel/10</td>
                            <td><strong>@(((eval.Punctuality + eval.Teamwork + eval.SkillLevel) / 3.0).ToString("F1"))</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-star fa-4x text-muted mb-3"></i>
            <h4>No evaluations yet</h4>
            <a asp-action="Create" class="btn btn-primary">Create First Evaluation</a>
        </div>
    </div>
}