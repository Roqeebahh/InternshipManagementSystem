@model IEnumerable<DailyLog>
@{
    ViewData["Title"] = "All Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-book me-2"></i>All Daily Logs</h2>
    <form method="get" class="d-flex">
        <input type="text" name="search" class="form-control me-2" placeholder="Search logs..." value="@ViewBag.Search" />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Intern</th>
                        <th>Activity</th>
                        <th>Submitted</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.LogDate.ToString("MMM dd, yyyy")</td>
                            <td>@log.Intern?.FullName</td>
                            <td>@(log.Activity.Length > 100 ? log.Activity.Substring(0, 100) + "..." : log.Activity)</td>
                            <td>@log.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-book fa-4x text-muted mb-3"></i>
            <h4>No logs found</h4>
        </div>
    </div>
}