@model IEnumerable<Project>
@{
    ViewData["Title"] = "All Projects";
}

<div class="row">
    <div class="col-12">
        <h2><i class="fas fa-project-diagram me-2"></i>All Projects</h2>
        <p class="text-muted">View all projects submitted by interns</p>
    </div>
</div>

@if (Model.Any())
{
    <div class="row">
        @foreach (var project in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">@project.Title</h5>
                        <small class="text-muted">By: @project.Intern?.FullName</small>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@(project.Description.Length > 100 ? project.Description.Substring(0, 100) + "..." : project.Description)</p>
                        <small class="text-muted">Submitted: @project.SubmissionDate.ToString("MMM dd, yyyy")</small>
                    </div>
                    <div class="card-footer bg-light">
                        @if (!string.IsNullOrEmpty(project.FilePath))
                        {
                            <a href="@project.FilePath" target="_blank" class="btn btn-sm btn-outline-success">
                                <i class="fas fa-download me-1"></i>Download
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-project-diagram fa-4x text-muted mb-3"></i>
            <h4>No projects submitted yet</h4>
        </div>
    </div>
}