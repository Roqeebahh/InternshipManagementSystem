@model IEnumerable<Evaluation>
@{
    ViewData["Title"] = "All Evaluations";
}

<div class="row">
    <div class="col-12">
        <h2><i class="fas fa-star me-2"></i>All Evaluations</h2>
        <p class="text-muted">View all evaluations conducted in the system</p>
    </div>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Intern</th>
                            <th>Supervisor</th>
                            <th>Punctuality</th>
                            <th>Teamwork</th>
                            <th>Skill Level</th>
                            <th>Average</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var eval in Model)
                        {
                            <tr>
                                <td>@eval.EvaluationDate.ToString("MMM dd, yyyy")</td>
                                <td>@eval.Intern?.FullName</td>
                                <td>@eval.Supervisor?.FullName</td>
                                <td><span class="badge bg-primary">@eval.Punctuality/10</span></td>
                                <td><span class="badge bg-success">@eval.Teamwork/10</span></td>
                                <td><span class="badge bg-info">@eval.SkillLevel/10</span></td>
                                <td><strong>@(((eval.Punctuality + eval.Teamwork + eval.SkillLevel) / 3.0).ToString("F1"))/10</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-star fa-4x text-muted mb-3"></i>
            <h4>No evaluations yet</h4>
        </div>
    </div>
}