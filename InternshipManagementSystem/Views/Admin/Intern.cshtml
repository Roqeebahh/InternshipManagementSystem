@model IEnumerable<Intern>
@{
    ViewData["Title"] = "Manage Interns";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users me-2"></i>Manage Interns</h2>
    <form method="get" class="d-flex">
        <input type="text" name="search" class="form-control me-2" placeholder="Search interns..." value="@ViewBag.Search" />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Institution</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var intern in Model)
                    {
                        <tr>
                            <td>@intern.FullName</td>
                            <td>@intern.Email</td>
                            <td>@intern.Institution</td>
                            <td>@intern.StartDate.ToString("MMM dd") - @intern.EndDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge bg-@(intern.IsActive ? "success" : "secondary")">
                                    @(intern.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <a asp-action="InternDetails" asp-route-id="@intern.InternId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i> View
                                </a>
                                <a asp-action="GenerateReport" asp-route-internId="@intern.InternId"
                                   class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-file-pdf"></i> Report
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-users fa-4x text-muted mb-3"></i>
            <h4>No interns found</h4>
        </div>
    </div>
}