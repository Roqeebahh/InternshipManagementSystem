@model IEnumerable<Project>
@{
    ViewData["Title"] = "My Projects";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-project-diagram me-2"></i>My Projects</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus me-1"></i>Submit New Project
    </a>
</div>

@if (Model.Any())
{
    <div class="row">
        @foreach (var project in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">@project.Title</h5>
                        <small class="text-muted">@project.SubmissionDate.ToString("MMM dd, yyyy")</small>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@(project.Description.Length > 100 ? project.Description.Substring(0, 100) + "..." : project.Description)</p>

                        @if (!string.IsNullOrEmpty(project.FileName))
                        {
                            <div class="d-flex align-items-center text-muted mb-2">
                                <i class="fas fa-file me-2"></i>
                                <span class="text-truncate">@project.FileName</span>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-light">
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@project.ProjectId"
                               class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-eye me-1"></i>View
                            </a>
                            @if (!string.IsNullOrEmpty(project.FilePath))
                            {
                                <a asp-action="Download" asp-route-id="@project.ProjectId"
                                   class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-download me-1"></i>Download
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-project-diagram fa-4x text-muted mb-3"></i>
            <h4>No projects submitted yet</h4>
            <a asp-action="Create" class="btn btn-success">Submit Your First Project</a>
        </div>
    </div>
}