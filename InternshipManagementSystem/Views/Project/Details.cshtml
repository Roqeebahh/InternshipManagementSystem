@model InternshipManagementSystem.Models.Project
@{
    ViewData["Title"] = "Project Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4><i class="fas fa-project-diagram me-2"></i>@Model.Title</h4>
                <small class="text-muted">Submitted on @Model.SubmissionDate.ToString("MMMM dd, yyyy")</small>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h5>Description</h5>
                    <p class="text-muted">@Model.Description</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.FileName))
                {
                    <div class="mb-4">
                        <h5>Attached File</h5>
                        <div class="d-flex align-items-center p-3 bg-light rounded">
                            <i class="fas fa-file fa-2x text-primary me-3"></i>
                            <div class="flex-grow-1">
                                <h6 class="mb-0">@Model.FileName</h6>
                                <small class="text-muted">Submitted: @Model.SubmissionDate.ToString("MMM dd, yyyy HH:mm")</small>
                            </div>
                            <a asp-action="Download" asp-route-id="@Model.ProjectId"
                               class="btn btn-outline-primary">
                                <i class="fas fa-download me-1"></i>Download
                            </a>
                        </div>
                    </div>
                }

                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Projects
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>