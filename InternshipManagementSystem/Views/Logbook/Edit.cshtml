@model DailyLog
@{
    ViewData["Title"] = "Edit Daily Log";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4><i class="fas fa-edit me-2"></i>Edit Daily Log Entry</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="DailyLogId" />
                    <input type="hidden" asp-for="InternId" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="LogDate" class="form-label">Date</label>
                        <input asp-for="LogDate" class="form-control" type="date" />
                        <span asp-validation-for="LogDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Activity" class="form-label">Activity Description</label>
                        <textarea asp-for="Activity" class="form-control" rows="8"></textarea>
                        <span asp-validation-for="Activity" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Update Log
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}