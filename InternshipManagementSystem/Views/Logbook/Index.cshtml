@model IEnumerable<InternshipManagementSystem.Models.DailyLog>
@{
    ViewData["Title"] = "Daily Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-book me-2"></i>Daily Logs</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Add New Log
    </a>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Activity</th>
                            <th>Submitted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.LogDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @(log.Activity.Length > 100 ? log.Activity.Substring(0, 100) + "..." : log.Activity)
                                </td>
                                <td>
                                    <small class="text-muted">@log.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@log.DailyLogId" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@log.DailyLogId"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('Are you sure you want to delete this log?')">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-book fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No daily logs yet</h4>
            <p class="text-muted">Start documenting your internship activities by creating your first daily log.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Create Your First Log
            </a>
        </div>
    </div>
}