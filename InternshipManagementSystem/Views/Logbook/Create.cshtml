@model InternshipManagementSystem.Models.DailyLog
@{
    ViewData["Title"] = "Add Daily Log";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4><i class="fas fa-plus me-2"></i>Add Daily Log Entry</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="LogDate" class="form-label">Date</label>
                        <input asp-for="LogDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="LogDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Activity" class="form-label">Activity Description</label>
                        <textarea asp-for="Activity" class="form-control" rows="8"
                                  placeholder="Describe what you worked on today, what you learned, challenges faced, and accomplishments..."></textarea>
                        <span asp-validation-for="Activity" class="text-danger"></span>
                        <div class="form-text">Be detailed about your daily activities and learning experiences.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Save Log
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to Logs
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}